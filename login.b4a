@EndOfDesignText@
	#Region  Project Attributes 
	    #ApplicationLabel: B4A Example
	    #VersionCode: 1
	    #VersionName: 
	    #SupportedOrientations: unspecified
	    #CanInstallToExternalStorage: False
	#End Region
	#Region  Activity Attributes 
	    #FullScreen: False
	    #IncludeTitle: False
	#End Region

	Sub Process_Globals
		Private xui As XUI
		Private Const SERVER_URL As String = "http://192.168.8.177:8001/Executioner/login.php"
	End Sub

	Sub Globals
		Private Button1 As Button
		Private Button2 As Button
		Private Button3 As Button

		Private EditText1 As EditText
		Private EditText3 As EditText   ' username/email
		Private EditText2 As EditText   ' password

		Private Panel1 As Panel
	End Sub

	Sub Activity_Create(FirstTime As Boolean)
		Activity.LoadLayout("login")
	End Sub

	Sub LoginUser(username As String, password As String)
    Dim job As HttpJob
    job.Initialize("login", Me)

    Dim params As Map
    params.Initialize
    params.Put("username", username)
    params.Put("password", password)

    job.PostMultipart(SERVER_URL, params, Null)
End Sub

	Sub JobDone(job As HttpJob)
		If job.JobName = "login" Then
			If job.Success Then
				Dim response As String = job.GetString.Trim.ToLowerCase
				Log("Response: " & response)

				If response = "success" Then
					ToastMessageShow("Login Success", False)
					StartActivity(dashboard)
					Activity.Finish
				Else
					ToastMessageShow("Login Failed", False)
				End If
			Else
				Log("Error: " & job.ErrorMessage)
				ToastMessageShow("Server Error: " & job.ErrorMessage, True)
			End If
		End If

		job.Release
	End Sub

	Private Sub Button1_Click
		StartActivity(signup)
	End Sub

	Private Sub Button2_Click   ' LOGIN BUTTON
		Dim username As String = EditText3.Text.Trim
		Dim password As String = EditText2.Text

		If username = "" Or password = "" Then
			ToastMessageShow("Please enter username and password", False)
			Return
		End If

		LoginUser(username, password)
	End Sub

	Private Sub Button3_Click
		StartActivity(forgotpass)
	End Sub